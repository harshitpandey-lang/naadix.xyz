{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naadix",
  "main": "site/worker.mjs",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/location"],
    "not_found_handling": "404-page",
  },
  "compatibility_flags": ["nodejs_compat"],
}
